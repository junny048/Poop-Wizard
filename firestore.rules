rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    match /scores/{docId} {
      allow read: if true;
      // Direct client writes are blocked. Use Cloud Functions submitScore.
      allow create, update, delete: if false;
    }
  }
}
